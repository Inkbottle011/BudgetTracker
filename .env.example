# Copy to .env and fill in. Everything starting with EXPO_PUBLIC_ is built into the website,
# so it must be safe for anyone to see. Never put secret keys here.

EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Linked banks use Plaid by default and need nothing here (Plaid keys live in the server function).
# Only if you use Teller instead:
# EXPO_PUBLIC_BANK_PROVIDER=teller
# EXPO_PUBLIC_TELLER_APP_ID=app_xxxxxxxxxxxx
# EXPO_PUBLIC_TELLER_ENV=sandbox
